{
  "name": "codesentinel",
  "displayName": "CodeSentinel Security Scanner",
  "description": "Multi-language Static Application Security Testing (SAST) & Agentic Security Auditor with MCP & OpenCode integration",
  "version": "0.2.2",
  "publisher": "codesentinel",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/codesentinel/codesentinel-vscode"
  },
  "keywords": [
    "security",
    "sast",
    "vulnerability",
    "scanner",
    "secrets",
    "opengrep",
    "gitleaks",
    "osv",
    "agentic",
    "ai",
    "mcp"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Security",
    "Linters",
    "AI",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "codesentinel-mcp": "./dist/mcp-server.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codesentinel.launchOpenCodeTerminal",
        "title": "CodeSentinel: Launch OpenCode in Active Workspace",
        "category": "CodeSentinel"
      },
      {
        "command": "codesentinel.openEmbeddedWeb",
        "title": "CodeSentinel: Focus Security Agent in Extension Sidebar",
        "category": "CodeSentinel"
      },
      {
        "command": "codeSentinel.openOpenCode",
        "title": "Code Sentinel: Open OpenCode",
        "category": "CodeSentinel"
      },
      {
        "command": "codesentinel.launchOpenCodeWeb",
        "title": "CodeSentinel: Launch OpenCode Web UI (Browser)",
        "category": "CodeSentinel"
      },
      {
        "command": "codesentinel.startOpenCodeServer",
        "title": "CodeSentinel: Start OpenCode Headless Server",
        "category": "CodeSentinel"
      },
      {
        "command": "codesentinel.syncOpenCodeConfig",
        "title": "CodeSentinel: Sync OpenCode MCP Configuration",
        "category": "CodeSentinel"
      },
      {
        "command": "codesentinel.toggleBackendMode",
        "title": "CodeSentinel: Switch Backend Mode (Local / Cloud)",
        "category": "CodeSentinel"
      },
      {
        "command": "codesentinel.buildContainer",
        "title": "CodeSentinel: Deploy / Build Unified Container Image",
        "category": "CodeSentinel"
      },
      {
        "command": "codesentinel.openCodeGraph",
        "title": "CodeSentinel: Open 360° Interactive Code Graph",
        "category": "CodeSentinel"
      },
      {
        "command": "codesentinel.indexAtlas",
        "title": "CodeSentinel: Index Codebase with Atlas Code Graph",
        "category": "CodeSentinel"
      },
      {
        "command": "codesentinel.installDependencies",
        "title": "CodeSentinel: Check and Install Host Dependencies (OpenCode & Atlas)",
        "category": "CodeSentinel"
      },
      {
        "command": "codesentinel.runCloudSecurityAudit",
        "title": "CodeSentinel: Run Cloud Security Audit with OpenCode",
        "category": "CodeSentinel"
      },
      {
        "command": "codesentinel.provisionSkills",
        "title": "CodeSentinel: Provision Security Audit Skills to OpenCode",
        "category": "CodeSentinel"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codesentinel-explorer",
          "title": "CodeSentinel",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "codesentinel-explorer": [
        {
          "type": "webview",
          "id": "codesentinel.controlCenter",
          "name": "Security & Agent Control Center"
        }
      ]
    },
    "configuration": {
      "title": "CodeSentinel",
      "properties": {
        "codesentinel.backendMode": {
          "type": "string",
          "enum": [
            "local",
            "cloud"
          ],
          "default": "local",
          "description": "Backend execution mode: local self-contained runtime or remote cloud endpoint."
        },
        "codesentinel.cloudEndpoint": {
          "type": "string",
          "default": "https://api.codesentinel.io/v1",
          "description": "Remote cloud endpoint URL when running in cloud mode."
        },
        "codesentinel.opencodePath": {
          "type": "string",
          "default": "opencode",
          "description": "Executable path for the OpenCode CLI."
        },
        "codesentinel.autoLaunchOpenCode": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open OpenCode session when a workspace repository is loaded."
        },
        "codesentinel.autoProvisionCloudSecurityAuditSkill": {
          "type": "boolean",
          "default": true,
          "description": "Automatically provision the Cloud Security Audit skill to OpenCode (.opencode/skills/cloud-security-audit) upon workspace load."
        },
        "codesentinel.mcpTimeout": {
          "type": "number",
          "default": 600000,
          "description": "Maximum per-tool execution timeout in milliseconds for OpenCode MCP tools (default: 600000ms / 10 minutes)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "node esbuild.config.mjs --production",
    "build:dev": "node esbuild.config.mjs",
    "test": "node dist/test/runner.js",
    "package": "npm run build && npx -y @vscode/vsce package --no-dependencies --allow-package-all-secrets",
    "publish": "npm run build && npx -y @vscode/vsce publish --no-dependencies --allow-package-all-secrets"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4"
  }
}
