{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codesentinel": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-v",
        "d:/CODESENTINELVSCODE:/workspace:ro",
        "-e",
        "CODESENTINEL_WORKSPACE=/workspace",
        "codesentinel/core:latest"
      ],
      "enabled": true
    },
    "atlas": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "--entrypoint",
        "atlas",
        "-v",
        "d:/CODESENTINELVSCODE:/workspace",
        "-w",
        "/workspace",
        "codesentinel/core:latest",
        "mcp"
      ],
      "enabled": true
    }
  }
}
