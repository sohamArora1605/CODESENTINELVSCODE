{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 60000,
      "catalog": 60000,
      "execution": 600000
    },
    "codesentinel": {
      "type": "local",
      "command": [
        "node",
        "./dist/mcp-server.js"
      ],
      "enabled": true,
      "timeout": 600000,
      "environment": {
        "CODESENTINEL_WORKSPACE": "."
      }
    },
    "atlas": {
      "type": "local",
      "command": [
        "node",
        "./dist/atlas-bridge.js",
        "local",
        "."
      ],
      "enabled": true,
      "timeout": 600000,
      "environment": {
        "CODESENTINEL_WORKSPACE": "."
      }
    }
  }
}