{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codesentinel": {
      "type": "local",
      "command": [
        "node",
        "d:/CODESENTINELVSCODE/dist/mcp-server.js"
      ],
      "enabled": true,
      "environment": {
        "CODESENTINEL_WORKSPACE": "D:/CODESENTINELVSCODE"
      }
    },
    "atlas": {
      "type": "local",
      "command": [
        "node",
        "d:/CODESENTINELVSCODE/dist/atlas-bridge.js",
        "local",
        "d:/CODESENTINELVSCODE"
      ],
      "enabled": true,
      "environment": {
        "CODESENTINEL_WORKSPACE": "D:/CODESENTINELVSCODE"
      }
    }
  }
}
